# ── Supabase ────────────────────────────────────────────────────────────────
# Local: `npx supabase start` prints these (`npx supabase status -o env`).
# Cloud: Supabase Dashboard → Project Settings → API Keys.
# The publishable key is safe in the browser — Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy projects can use the anon JWT instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin used in email links (confirmation, password reset).
# Leave empty locally; set to your production domain on Vercel.
NEXT_PUBLIC_SITE_URL=

# NEVER expose service-role / secret keys with a NEXT_PUBLIC_ prefix.
